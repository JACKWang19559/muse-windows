    "package:win": "npm run build && node scripts/package.cjs"
  },
  "dependencies": {
    "dompurify": "3.4.17",
    "esbuild": "0.28.2",
    "fflate": "0.8.3",
    "lucide-react": "1.60.0",
    "marked": "18.1.1",
    "parse5": "8.0.1",
    "pdf-parse": "2.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "electron": "44.9.1"
  }
}
